# Telegram (MVP dashboard + approval layer)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Approval link signing for the Telegram callback worker (any long random string)
APPROVAL_SECRET=

# Gmail reply watcher.
# OAuth is file-based: put credentials.json + token.json in ./secrets/ (gitignored).
# These are copied from the linkedin-ai-assistant project; no client id/secret in .env.
GMAIL_LABEL=LinkedInAccepted
GMAIL_POLL_SECONDS=60

# Claude intelligence provider.
# Auth uses your Anthropic subscription via `ant auth login` (an OAuth profile the
# SDK reads automatically) - do NOT set ANTHROPIC_API_KEY or any other LLM key.
CLAUDE_MODE=mock
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_MAX_EVALUATIONS=25
# Local live mode (`run_agent.py live --ai local`) uses the signed-in Claude Code
# CLI instead of the SDK. Optional overrides:
# CLAUDE_CLI_MODEL=claude-opus-5
# CLAUDE_CLI_TIMEOUT=300

# Career Ops: pinned Apify actors (Naukri / LinkedIn discovery). Only used when
# config/sources.yaml -> sources.career_ops.enabled is true. Apify account token,
# Settings -> Integrations -> API tokens. This is an Apify token, not an LLM key.
APIFY_TOKEN=

# Adzuna job API - free tier, ~250 calls/month. https://developer.adzuna.com
# Only used when config/sources.yaml -> sources.adzuna.enabled is true.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
