# Telegram (MVP dashboard + approval layer)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Approval link signing for the Telegram callback worker (any long random string)
APPROVAL_SECRET=

# Gmail reply watcher.
# OAuth is file-based: put credentials.json + token.json in ./secrets/ (gitignored).
# These are copied from the linkedin-ai-assistant project; no client id/secret in .env.
GMAIL_LABEL=LinkedInAccepted
GMAIL_POLL_SECONDS=60

# Claude intelligence provider.
# Auth uses your Anthropic subscription via `ant auth login` (an OAuth profile the
# SDK reads automatically) - do NOT set ANTHROPIC_API_KEY or any other LLM key.
CLAUDE_MODE=mock
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_MAX_EVALUATIONS=25
